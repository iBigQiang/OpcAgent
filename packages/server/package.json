{
  "name": "@opcagent/server",
  "version": "0.1.1",
  "description": "Standalone headless OPC Agent server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "opcagent-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": "OPC Agent contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/iBigQiang/OpcAgent",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opcagent/core": "workspace:*",
    "@opcagent/server-core": "workspace:*",
    "@opcagent/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
